enum ResumeStorageProvider {
  cloudinary
  s3

  @@map("resume_storage_provider")
}

enum ResumeAiStatus {
  pending
  processing
  processed
  failed

  @@map("resume_ai_status")
}

enum ResumeAnalysisProvider {
  gemini
  openai

  @@map("resume_analysis_provider")
}

enum RoleReadinessLevel {
  Low
  Medium_Low @map("Medium-Low")
  Medium
  Medium_High @map("Medium-High")
  High

  @@map("role_readiness_level")
}

model Resume {
  id                String              @id @default(cuid())
  userId            String              @unique
  resumeAnalysisId  String?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFileUrl   String?             @db.Text
  extractedText     String              @db.Text
  targetRole        String?             @db.VarChar(120)
  experienceLevel   String?             @db.VarChar(120)
  checksum          String              @db.Char(64)
  fileName          String
  fileSize          Int
  mimeType          String
  resourceType      String
  storageProvider   ResumeStorageProvider
  publicId          String
  secureUrl         String
  aiStatus          ResumeAiStatus      @default(pending)
  aiLastProcessedAt DateTime?
  aiFailureReason   String?             @db.VarChar(2000)
  softDeleted       Boolean             @default(false)
  resumeAnalysis    ResumeAnalysis[]
  preparationPlans  PreparationPlan[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, softDeleted, createdAt])
  @@index([checksum])
  @@map("resume")
}

model ResumeAnalysis {
  id                    String                @id @default(cuid())
  resumeId              String
  resume                Resume                @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  preparationPlanId     String?               @unique
  preparationPlan       PreparationPlan?      @relation(fields: [preparationPlanId], references: [id], onDelete: Cascade)
  providerUsed          ResumeAnalysisProvider
  modelUsed             String                @db.VarChar(120)
  resumeScore           Float?
  resumeScoreBreakdown   Json?
  roleFitScore          Float?
  roleFitBreakdown       Json?
  summary               String?               @db.Text
  candidateSnapshot     Json?
  strengths             String[]              @default([])
  weaknesses            String[]              @default([])
  matchedSkills         String[]              @default([])
  missingSkills         String[]              @default([])
  skillAnalysis         Json?
  experienceGapAnalysis Json
  roleReadinessLevel    RoleReadinessLevel
  roleReadinessRationale String?              @db.Text
  learningPlanFoundation Json?
  hiringRecommendation  Json?
  dataConfidence        Json?
  suggestions           String[]              @default([])
  extractedTextSummary  String?               @db.Text
  insights              Json?
  inputTokens           Int                   @default(0)
  outputTokens          Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([resumeId, createdAt])
  @@map("resume_analysis")
}
